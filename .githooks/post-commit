#!/usr/bin/env bash
# Repo post-commit: rebuild and atomically install the statusline binary to the
# stable location. Dispatched by the user-level ~/.git-hooks/post-commit runner,
# which is itself chained from ~/.dotfiles/git-global-hooks via chain_hook.
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
exec "$repo_root/scripts/deploy-statusline.sh" "$@"
